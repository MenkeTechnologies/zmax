 {
  "id": "vis.loops-and-conditionals.x",
  "source": "vis",
  "category": "loops-and-conditionals",
  "name": "x/ regexp / command",
  "desc": "For each match of the regular expression in the range, run the command with range set to the match. If the regular expression and its slashes are omitted, \"/.*\\[rs]n/\" is assumed. Null string matches potentially occur before every character of the range and at the end of the range. The '1 Ns \\(en Ns Ic '9 and '& registers are updated with the (sub) expression matches of the pattern. .",
  "doc_ref": "https://github.com/martanne/vis/blob/master/man/vis.1#L645"
 },
 {
  "id": "vis.loops-and-conditionals.y",
  "source": "vis",
  "category": "loops-and-conditionals",
  "name": "y/ regexp / command",
  "desc": "Like x , but run the command for each substring that lies before, between, or after the matches that would be generated by x . There is no default behavior. Null substrings potentially occur before every character in the range. .",
  "doc_ref": "https://github.com/martanne/vis/blob/master/man/vis.1#L660"
 },
 {
  "id": "vis.loops-and-conditionals.x_2",
  "source": "vis",
  "category": "loops-and-conditionals",
  "name": "X/ regexp \"/\" command",
  "desc": "For each file whose file name matches the regular expression, make that the current file and run the command. If the expression is omitted, the command is run in every file. .",
  "doc_ref": "https://github.com/martanne/vis/blob/master/man/vis.1#L669"
 },
 {
  "id": "vis.loops-and-conditionals.y_2",
  "source": "vis",
  "category": "loops-and-conditionals",
  "name": "Y/ regexp / command",
  "desc": "Same as X , but for files that do not match the regular expression, and the expression is required. .\\\" TODO improve markup, use Op macro, make it actually understandable :/",
  "doc_ref": "https://github.com/martanne/vis/blob/master/man/vis.1#L674"
 },
 {
  "id": "vis.loops-and-conditionals.g",
  "source": "vis",
  "category": "loops-and-conditionals",
  "name": "g [ count ] [ /regexp/ ] command v [ count ] [ /regexp/ ] command",
  "desc": "If the count range contains g or does not contain v a match for the expression, run command on the range. The count specifier has the following format, where n and m are integers denoting the ranges.",
  "doc_ref": "https://github.com/martanne/vis/blob/master/man/vis.1#L681"
 },
 {
  "id": "vis.loops-and-conditionals.n",
  "source": "vis",
  "category": "loops-and-conditionals",
  "name": "n , m",
  "desc": "The closed interval from n to m . If n is missing, 1 is substituted. If m is missing, ∞ is substituted. Negative values are interpreted relative to the last range.",
  "doc_ref": "https://github.com/martanne/vis/blob/master/man/vis.1#L702"
 },
